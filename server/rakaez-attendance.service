[Unit]
Description=Rakaez background attendance states
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/rakaez/attendance-worker/attendance-worker.py
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
